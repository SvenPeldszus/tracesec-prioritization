<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="org.tracesec.feature"
      label="TraceSec Feature"
      version="1.0.0.qualifier"
      provider-name="Ruhr University Bochum">

   <description url="https://github.com/SvenPeldszus/tracesec-prioritization">
      TraceSec issue prioritization and supporting models and tooling.
   </description>

   <copyright>
      Copyright Ruhr University Bochum.
   </copyright>

   <requires>
      <!-- GRaViTY UML transitively provides the Eclipse, MoDisco and type-graph stack used by TraceSec. -->
      <import feature="org.gravity.features.uml" version="1.0.0.qualifier"/>
      <!-- Install the supported SonarQube for IDE distribution; individual bundle requirements remain in plugin manifests. -->
      <import feature="org.sonarlint.eclipse.feature" version="12.7.0.84850" match="compatible"/>
   </requires>

   <plugin
         id="org.tracesec.prioritization"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.graph.dsl.ide"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.graph.dsl.ui"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.requirements"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.qualitymodel"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.graph.dsl"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.tracesec.prioritization.ui"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <plugin
         id="org.gravity.typegraph.sonarlint"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

   <!-- TraceSec needs the antipattern metamodel, not the complete Hulk feature and its Henshin stack. -->
   <plugin
         id="org.gravity.hulk.antipatterngraph"
         download-size="0"
         install-size="0"
         version="0.0.0"
         unpack="false"/>

</feature>
